# Public origin used to build short URLs in API responses.
BASE_URL=http://localhost:8000

# Omit both and the app falls back to SQLite + an in-memory cache.
DATABASE_URL=postgresql+asyncpg://shortener:shortener@localhost:5432/shortener
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=1440

SHORTCODE_LENGTH=7
CACHE_TTL_SECONDS=3600
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
REDIRECT_RATE_LIMIT_REQUESTS=600
